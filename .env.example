# Contact form email delivery (optional). Without this, the form
# gracefully falls back to a "email me directly" mailto link.
RESEND_API_KEY=

# Inbox that contact-form messages should land in. Defaults to the
# email in src/data/site.ts if unset.
CONTACT_TO_EMAIL=

# Used to build absolute URLs for metadata, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
